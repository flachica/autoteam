{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Front dev",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/autoteam-front/node_modules/next/dist/bin/next",
            "args": ["dev", "-p", "4000"],
            "runtimeArgs": ["--inspect=9230"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"],
            "cwd": "${workspaceFolder}/autoteam-front"
        },
        {
            "name": "Back dev",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "start:debug", "--", "--inspect=9229"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}/autoteam-back"
        },
        {
            "name": "Build front",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
            "args": ["build"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Back start",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
            "args": ["start"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
